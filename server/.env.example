# Every variable is optional; the defaults are right for local development.

# Browser origins allowed to talk to the server, comma-separated. "*" while
# testing; the deployed client's exact origin once the URL settles.
CORS_ORIGINS=*

# Shared secret for editing the deck at /deck. Unset means anyone with the URL
# can add and remove songs, which matches the rest of the game (no accounts).
# When set, open the editor as /deck?token=<value> once; it remembers it.
DECK_TOKEN=

# Where the SQLite file lives. Defaults to server/hitster.db.
DB_PATH=

# Whether the database is thrown away on deploy. Detected automatically on
# Render and Fly; set "persistent" once a disk is attached, or "ephemeral" on a
# host the detection does not know.
DECK_STORAGE=
